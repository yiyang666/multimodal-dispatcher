DISPATCHER_BIND_IP=127.0.0.1
DISPATCHER_ADMIN_TOKEN=replace-with-a-long-random-token
MODELS_FILE=/app/config/models.yaml
# 0 disables automatic idle release.
IDLE_TIMEOUT_SECONDS=600
IDLE_CHECK_INTERVAL_SECONDS=30
# How long a cross-model request may wait for the current workload to finish.
SWITCH_WAIT_TIMEOUT_SECONDS=900
# Optional ComfyUI text-to-image defaults
# COMFY_T2I_WORKFLOW=/app/workflows/qwen_image_t2i_api.json
# COMFY_T2I_STEPS=30
# COMFY_T2I_CFG=4
# COMFY_T2I_TIMEOUT=600
